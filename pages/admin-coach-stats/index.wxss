.admin-sub-page {
  min-height: 100vh;
  background: #f7f9ff;
}

.header-wrapper {
  position: relative;
  z-index: 2;
  padding-left: 32rpx;
  padding-right: 32rpx;
  box-sizing: border-box;
}

.admin-scroll {
  box-sizing: border-box;
  padding: 24rpx 32rpx 48rpx;
}

.coach-head {
  background: #fff;
  border-radius: 16rpx;
  border: 1rpx solid #e8ecf4;
  padding: 28rpx 24rpx;
  margin-bottom: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.coach-head-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.coach-head-phone {
  font-size: 26rpx;
  color: #666;
  font-family: ui-monospace, monospace;
}

.picker-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  border: 1rpx solid #e8ecf4;
  margin-bottom: 20rpx;
}

.picker-label {
  font-size: 28rpx;
  color: #333;
}

.picker-value {
  font-size: 28rpx;
  color: #134e35;
}

.submit-btn {
  background: #134e35;
  color: #fff;
  border-radius: 16rpx;
  font-size: 30rpx;
  margin-bottom: 32rpx;
}

.detail-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  border: 1rpx solid #e8ecf4;
  margin-bottom: 16rpx;
}

.detail-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #134e35;
  margin-bottom: 12rpx;
}

.section-sub {
  display: block;
  font-size: 22rpx;
  color: #888;
  line-height: 1.45;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #eef1f6;
}

.detail-block--total {
  padding-bottom: 16rpx;
  margin-bottom: 24rpx;
  border-bottom: 1rpx solid #eef1f6;
}

.detail-block {
  margin-bottom: 20rpx;
}

.detail-block:last-child {
  margin-bottom: 0;
}

.detail-line {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 28rpx;
  padding: 6rpx 0;
  color: #333;
}

.detail-line--head {
  font-weight: 500;
  padding-bottom: 4rpx;
}

.detail-sum {
  color: #134e35;
  font-weight: 600;
}

.detail-muted {
  color: #888;
  font-size: 26rpx;
}

.warn {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #b45309;
  line-height: 1.4;
}
